# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Telegram collector (telegram_collector.py) — https://my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT_ID=          # e.g. -100xxxxxxxxxx (group/channel id to collect)

# News event agent (news_event_agent.py)
# NEWS_AGENT_DAILY_LIMIT=20        # max reports per day (UTC)
# NEWS_AGENT_DEEP_MODEL=opus       # report model
# NEWS_AGENT_QUICK_MODEL=haiku     # classification model

# Login gateway (auth_gateway.py serve)
# APP_PASSWORD_HASH is written by: python auth_gateway.py set-password  (never put a plain password here)
APP_PASSWORD_HASH=
# APP_HOST=0.0.0.0           # address to expose (0.0.0.0 = company LAN, 127.0.0.1 = this PC only)
# APP_PORT=8501              # login gateway port
# APP_BACKEND_PORT=8502      # internal Streamlit port (127.0.0.1 only)
# APP_SESSION_HOURS=12       # login lifetime
# APP_COOKIE_SECURE=0        # set 1 when served over HTTPS
